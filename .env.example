# Copy this file to ".env" (same folder) and fill in the first block.
# Never share .env, sniper_session.session or robinhood.pickle - they unlock your accounts.

# --- Telegram (from my.telegram.org > API development tools) ---
TG_API_ID=
TG_API_HASH=
# Run "python sniper_shadow.py --list-chats" and paste the Sniper Trades number here
TG_CHAT_ID=

# --- Robinhood ---
RH_USERNAME=
# Leave blank: the script asks for your password each morning (safer than saving it here)
RH_PASSWORD=
ADD_TO_WATCHLIST=true
# Create a list with exactly this name in the Robinhood app first
WATCHLIST_NAME=Sniper Test

# --- LIVE TRADING (real orders). Leave false until you are ready. ---
LIVE_TRADING=false
# Optional phone push alerts: create a bot with @BotFather in Telegram, paste its token here,
# send the bot any message, then put your numeric chat id below (see LIVE.md)
TG_BOT_TOKEN=
TG_NOTIFY_CHAT_ID=

# --- Sizing and lottos ---
# Contracts per alert
CONTRACTS_PER_TRADE=1
# Runner: buy 2 when both fit within MAX_SINGLE_CONTRACT_COST (lottos: always 1). The first is sold at his first trim (or the
# take-profit); the runner only when he is fully out, or if its mid falls back to what we paid
KEEP_RUNNER=true
# His red double-exclamation (or the word "lotto") = lotto. Only copy lottos priced under this
LOTTO_MAX_PRICE=2.50
# Emergency exit when a position's mid price is down this % from what we paid (0 = off)
DISASTER_STOP_PCT=50
# Sell as soon as the bid is more than this % above what we paid (0 = off)
TAKE_PROFIT_PCT=40
MAX_BUYS_PER_DAY=6
# Late entry: how many minutes after he posts a buy alert it is still copied (the ask must still be within
# the cap). 0DTE uses LATE_ENTRY_MIN, short-dated (1-7 days out) LATE_ENTRY_MIN_SHORT, swings (8+ days)
# LATE_ENTRY_MIN_SWING. A late swing is looked at again 15 s later and only bought if he hasn't sold any of it.
LATE_ENTRY_MIN=10
LATE_ENTRY_MIN_SHORT=2
LATE_ENTRY_MIN_SWING=60
# Watch-and-buy: if the ask is above our cap (his price + ENTRY_CAP_PCT) when he posts, and the option
# expires MORE than WATCH_MIN_DTE days out, keep checking for WATCH_MIN minutes and buy when the ask
# comes back within the cap - unless he sells first. WATCH_MIN=0 turns it off.
WATCH_MIN=60
WATCH_MIN_DTE=3
# How often (seconds) open positions are checked for take-profit / emergency stop
EXIT_CHECK_SEC=10
# THE PROJECT POT: all live trading is limited to this much money. Realized live wins add to it,
# losses subtract. When it reaches 0 the project ENDS: no more buys, ever (exits still work).
# To start a new project later, raise this number and restart.
PROJECT_CAPITAL=5000
# Live order timing
BUY_TIMEOUT_SEC=15
SELL_ATTEMPT_SEC=8
# How we price a buy: ask plus this many price steps, never above his price + ENTRY_CAP_PCT
BUY_CUSHION_TICKS=1

# --- Guardrails (starting values - change any of them) ---
BUDGET_PER_TRADE=500
# A single contract costing more than this is skipped
MAX_SINGLE_CONTRACT_COST=1000
# Skip the buy if the ask is more than this % above his price
ENTRY_CAP_PCT=10
# Skip the buy if the ask is more than this % BELOW his price (usually a typo / wrong contract)
ENTRY_FLOOR_PCT=30
# Copy his long puts too (false = calls only)
ALLOW_PUTS=true
# Skip contracts whose bid-ask spread is wider than this % of the mid
MAX_SPREAD_PCT=15
# ...but first re-check a too-wide spread for this many seconds (it is often a one-quote blip). 0 = skip at once
SPREAD_RECHECK_SEC=60
# An alert older than this many seconds counts as late (how late is allowed: LATE_ENTRY_MIN above)
MAX_ALERT_AGE_SEC=60
# No buys in the first N minutes after 9:30
OPEN_BUFFER_MIN=1
MAX_OPEN_POSITIONS=4
# Never hold two of his contracts on the same stock at once (e.g. MU 1100C and MU 1130C)
ONE_POSITION_PER_STOCK=true
# Most money that may be tied up in open positions at once (also limited by the free project pot)
MAX_DEPLOYED=5000
DAILY_LOSS_LIMIT=750
# How to split his partial sells over our contracts: down (keep more), up (sell more) or
# nearest (with 1 contract: sell once he has sold half or more)
PARTIAL_ROUNDING=nearest
# Close anything still open at this time on its expiry day
EXPIRY_CLOSE_TIME=15:30
# Post each decision to your Telegram "Saved Messages"
NOTIFY_SAVED_MESSAGES=true

# --- Price tracking (observation week) ---
# How often to record the price of each contract he holds
TRACK_INTERVAL_SEC=30
# Keep recording this long after he is fully out
POST_EXIT_TRACK_MIN=30
# First run only: how many days of old messages to read
BACKFILL_DAYS=7
# Print an "alive" status line every N minutes
HEARTBEAT_MIN=5
# Mistyped exit alerts: his price must be within this % of the live bid/ask, and the alert
# must be under this many seconds old, before the closest contract is accepted
TYPO_PRICE_TOL_PCT=8
TYPO_MAX_AGE_SEC=120
# Record any freeze longer than this many seconds (PC sleep, paused window)
STALL_WARN_SEC=60
